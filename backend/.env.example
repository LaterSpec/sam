# SAM · backend environment (copy to .env and fill in)
# cp .env.example .env

# ── Newroad API (live IBKR prices via cuantito-compatible feed) ──
NEWROAD_USERNAME=your_user@example.com
NEWROAD_PASSWORD=your_password
# Optional override (default: https://api.newroadai.com/api/v1)
# NEWROAD_API_BASE=https://api.newroadai.com/api/v1

# ── Local Supabase Postgres (Python jobs write market_* tables) ───
# Default matches `supabase start` on port 54322
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
