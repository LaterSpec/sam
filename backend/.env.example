# SAM · backend environment (copy to .env and fill in)
# cp .env.example .env

# ── IBKR Gateway (live market prices via IBGateway SSE feed) ────
IBG_USERNAME=your_ibkr_user@example.com
IBG_PASSWORD=your_ibkr_password
# Optional override (default: https://localhost:5000/v1/api)
# IBG_API_BASE=https://localhost:5000/v1/api

# Historical note:
# This backend folder is archived. The active app uses Neon via DATABASE_URL
# and TypeScript market sync in lib/market/yahoo-sync.ts.
