{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "sam-app",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sam-app"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "BETTER_AUTH_URL": "https://sam-app.its-manuel-caceres.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://sam-app.its-manuel-caceres.workers.dev",
    "RECURRING_CRON_ENABLED": "false"
  }
}
