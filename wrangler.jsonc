{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sam-app",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sam-app"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://sam-app.its-manuel-caceres.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://sam-app.its-manuel-caceres.workers.dev"
  }
}
