# App
NEXT_PUBLIC_APP_NAME="SAM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon Postgres (pooled connection for serverless)
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/sam?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Email/password auth enabled by default; set to "false" to disable
BETTER_AUTH_EMAIL_ENABLED="true"

# Google OAuth (GCP → Credentials → OAuth client ID → Web application)
# Orígenes JavaScript autorizados: http://localhost:3000 (+ prod URL)
# URIs de redireccionamiento: http://localhost:3000/api/auth/callback/google (+ prod)
# BETTER_AUTH_URL must match the origin above (no trailing slash)
# Cloudflare prod example:
#   BETTER_AUTH_URL=https://sam-app.its-manuel-caceres.workers.dev
#   NEXT_PUBLIC_APP_URL=https://sam-app.its-manuel-caceres.workers.dev
#   redirect URI: https://sam-app.its-manuel-caceres.workers.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Market sync route bearer secret
CRON_SECRET="your-cron-secret"

# MCP personal token hashing pepper (salts the SHA-256 of token secrets)
# Generate with: openssl rand -base64 32
# Set in production with: wrangler secret put MCP_TOKEN_PEPPER
MCP_TOKEN_PEPPER="generate-a-unique-random-value"

# Recurring cron rollout switch (non-secret). Keep false to avoid Neon CU burn.
RECURRING_CRON_ENABLED="false"
