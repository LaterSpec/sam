# App
NEXT_PUBLIC_APP_NAME="SAM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon Postgres (pooled connection for serverless)
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/sam?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Email/password auth enabled by default; set to "false" to disable
BETTER_AUTH_EMAIL_ENABLED="true"

# Google OAuth (GCP → Credentials → OAuth client ID → Web application)
# Orígenes JavaScript autorizados: http://localhost:3000 (+ prod URL)
# URIs de redireccionamiento: http://localhost:3000/api/auth/callback/google (+ prod)
# BETTER_AUTH_URL must match the origin above (no trailing slash)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Market cron (Vercel Cron secret header)
CRON_SECRET="your-cron-secret"
